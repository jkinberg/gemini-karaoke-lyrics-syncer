{
  "name": "karaoke-syncer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server.ts",
    "build": "vite build && tsc server.ts --outDir dist-server --esModuleInterop --module nodenext --moduleResolution nodenext --target ES2022 --skipLibCheck",
    "preview": "vite preview",
    "start": "node dist-server/server.js"
  },
  "dependencies": {
    "@google/genai": "^1.25.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.0",
    "jszip": "3.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
